# Ignore all files
*

# Don't ignore nugetconfig
!./NuGet.Config

# Don't ignore src projects
!src/**
!docker-entrypoint.sh

# ignore bin and obj folders in projects
src/**/bin/*
src/**/obj/*

# Keep runtime config files in the bot data folder available to the container
!src/NadekoBot/data/
!src/NadekoBot/data/**